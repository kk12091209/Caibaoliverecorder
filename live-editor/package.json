{
  "name": "bili-live-editor",
  "version": "0.4.8",
  "buildRevision": 5,
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run build:upload-sdk",
    "dev": "node scripts/dev.js",
    "predev:server": "npm run build:upload-sdk",
    "dev:server": "node scripts/dev.js --no-ui",
    "test:dev": "node --test scripts/dev.test.js",
    "prebuild": "npm run build:upload-sdk",
    "build": "vite build",
    "build:upload-sdk": "node scripts/build-bilibili-upload-sdk.mjs dist-server/bilibili-upload-sdk.cjs dist-server/bilibili-upload-sdk-NOTICES.txt",
    "prestart": "npm run build:upload-sdk",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint \"src/**/*.vue\" \"src/use-*.js\" \"server/*-routes.js\" server/index.js \"server/*-platform.js\" server/multi-platform-recorder.js server/room-lookup.js server/http-response.js server/app-activity.js server/workbench-snapshot.js server/app-lifecycle.js"
  },
  "dependencies": {
    "@renmu/bili-api": "2.15.2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "vite": "^7.0.0"
  }
}
