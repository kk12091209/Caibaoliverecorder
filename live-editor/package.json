{
  "name": "bili-live-editor",
  "version": "0.4.3-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node scripts/dev.js --no-ui",
    "test:dev": "node --test scripts/dev.test.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint \"src/**/*.vue\" \"src/use-*.js\" \"server/*-routes.js\" server/index.js \"server/*-platform.js\" server/multi-platform-recorder.js server/room-lookup.js server/http-response.js server/app-activity.js server/workbench-snapshot.js server/app-lifecycle.js"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "vite": "^7.0.0"
  }
}
