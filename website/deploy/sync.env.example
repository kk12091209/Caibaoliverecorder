# Copy to /etc/caibao/sync.env on the server only; chmod 600, owner root.
COS_BUCKET=REPLACE_WITH_BUCKET_NAME_AND_APPID
COS_REGION=ap-singapore
DOWNLOAD_BASE_URL=https://download.caibao.media
COS_SECRET_ID=
COS_SECRET_KEY=

# Public repositories can be read anonymously. For private repos choose one:
# Option A: GitHub App installed on the configured repositories, Contents read only.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# Docker: mount the server key directory at /keys (see DEPLOYMENT.md).
# GITHUB_APP_PRIVATE_KEY_FILE=/keys/github-app.pem
# Native Node alternative: use the absolute host path instead.
# Option B: Fine-grained token for only the required repositories, Contents read only.
# GITHUB_TOKEN=
