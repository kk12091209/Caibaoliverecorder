FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /app
COPY deploy/services/sync/package.json deploy/services/sync/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY scripts/sync-releases.mjs scripts/release-core.mjs scripts/http.mjs scripts/desktop-update.mjs scripts/update-trust.mjs ./scripts/
COPY deploy/products.json ./deploy/products.json
USER 10001:10001
CMD ["node", "scripts/sync-releases.mjs"]
