handle /releases/caibo-recording-policy.json {
    uri strip_prefix /releases
    root * /srv/caibao/recorder-policy/public
    header Cache-Control "public, max-age=60, must-revalidate"
    file_server
}
handle /releases/caibo-recording-policy-beta.json {
    uri strip_prefix /releases
    root * /srv/caibao/recorder-policy/public
    header Cache-Control "public, max-age=60, must-revalidate"
    file_server
}
handle /admin/recorder-policy {
    basic_auth bcrypt {
        import /srv/caibao/recorder-policy/maintainer.auth
    }
    request_body {
        max_size 4KB
    }
    reverse_proxy caibao-recorder-policy:8795 {
        header_up -Authorization
    }
}
