# Merge this global option into an existing global block when importing sites.
# HTTPS is retained. Public download probes showed severe HTTP/2 throughput
# loss on the current route; prefer HTTP/1.1 until that route is revalidated.
{
    servers :443 {
        protocols h1
    }
}

caibao.media {
    # A pending attachment needs its headers before media bytes are available.
    # encode otherwise delays that flush while waiting to inspect the body.
    @compressible not path /api/downloader/jobs/*/stream /api/downloader/jobs/*/download /api/downloader/jobs/*/files/* /api/downloader-xhs/jobs/*/stream /api/downloader-xhs/jobs/*/download /api/downloader-xhs/jobs/*/files/* /api/downloader-xhs-v2/jobs/*/stream /api/downloader-xhs-v2/jobs/*/download /api/downloader-xhs-v2/jobs/*/files/*
    encode @compressible zstd gzip
    header {
        Alt-Svc clear
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @privateSource path /.parcel-private* /@fs/* /server/* /shared/* /scripts/*
    handle @privateSource {
        respond 404
    }
    # Retired product: old bookmarks and cached clients must not reach a service.
    @retiredParcel path /tools/parcel-assistant /tools/parcel-assistant/* /works/parcel-assistant /works/parcel-assistant/* /api/parcel /api/parcel/*
    handle @retiredParcel {
        header Cache-Control "no-store"
        respond "此功能已下线。" 410
    }
    handle /api/downloader-xhs-v2/* {
        request_body {
            max_size 24KB
        }
        reverse_proxy caibao-downloader-xhs-v2:8790 {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 20m
            }
        }
    }
    handle /api/downloader-xhs/* {
        request_body {
            max_size 24KB
        }
        reverse_proxy caibao-downloader-xhs:8790 {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout 20m
            }
        }
    }
    handle /api/downloader/* {
        request_body {
            max_size 24KB
        }
        @downloadFile {
            method GET HEAD
            path_regexp downloadFile ^/api/downloader/jobs/[0-9a-f]{36}/(download|files/[0-9a-f]{36})$
        }
        @streamFile {
            method GET HEAD
            path_regexp streamFile ^/api/downloader/jobs/[0-9a-f]{36}/stream$
        }
        route {
            handle @streamFile {
                reverse_proxy caibao-downloader:8790 {
                    flush_interval -1
                    transport http {
                        dial_timeout 5s
                        response_header_timeout 20m
                    }
                }
            }
            # The API owns a read lease until transfer ends. Serving bytes in a
            # separate file_server would hide active readers from cache cleanup.
            handle @downloadFile {
                reverse_proxy caibao-downloader:8790 {
                    flush_interval -1
                    transport http {
                        dial_timeout 5s
                        response_header_timeout 20m
                    }
                }
            }
            handle {
                reverse_proxy caibao-downloader:8790 {
                    transport http {
                        dial_timeout 5s
                        response_header_timeout 120s
                    }
                }
            }
        }
    }
    handle /releases/* {
        uri strip_prefix /releases
        root * /srv/caibao/catalog
        header Cache-Control "public, max-age=60, must-revalidate"
        file_server
    }
    handle /assets/* {
        root * /srv/caibao/current
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/caibao/current
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

www.caibao.media {
    redir https://caibao.media{uri} permanent
}

# A small redirect keeps certificate renewal here; installers flow directly from COS.
download.caibao.media {
    header Cache-Control "no-cache"
    redir {$COS_PUBLIC_ORIGIN}{uri} 302
}
