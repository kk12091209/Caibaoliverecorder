{
  "name": "caibao-universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:downloader": "node scripts/dev-downloader.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "sync:check": "node scripts/sync-releases.mjs --dry-run",
    "sync:releases": "node scripts/sync-releases.mjs",
    "runtime:sync": "node scripts/runtime-packages.mjs",
    "package:deploy": "npm run build && node scripts/package-deploy.mjs",
    "build:tutorial": "tsc --noEmit && vite build --mode tutorial",
    "package:deploy:tutorial": "npm run build:tutorial && node scripts/package-deploy.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\"",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "cos-nodejs-sdk-v5": "3.0.0",
    "fflate": "0.8.3",
    "mediabunny": "1.61.5",
    "playwright-core": "1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "sharp": "0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.2",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk12091209/Caibaoliverecorder.git",
    "directory": "website"
  }
}
